<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TreeTileSizeStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <!--  Основной Grid с анимациями  -->
                    <Grid
                        x:Name="SizeGrid"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}">
                        <!--  Ваш контент (используем ContentPresenter)  -->
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  Состояния размера  -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="ExtraSmall">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Width"
                                            To="80"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Height"
                                            To="80"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Small">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Width"
                                            To="100"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Height"
                                            To="100"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Medium">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Width"
                                            To="150"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Height"
                                            To="150"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Large">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Width"
                                            To="200"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Height"
                                            To="200"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ExtraLarge">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Width"
                                            To="250"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SizeGrid"
                                            Storyboard.TargetProperty="Height"
                                            To="250"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
