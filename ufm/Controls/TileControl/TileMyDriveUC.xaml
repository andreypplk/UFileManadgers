<?xml version="1.0" encoding="utf-8" ?>

<ufm:BaseTileControl
	x:Class="ufm.TileMyDriveUc"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ufm="using:ufm"
	
	mc:Ignorable="d">

	<UserControl.Resources>
		<ufm:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	</UserControl.Resources>

	<Grid
		Width="{x:Bind Width, Mode=OneWay}"
		Height="{x:Bind Height, Mode=OneWay}"
		Background="Transparent">

		<Border
			x:Name="BorderTileMyDriveUC"
			Margin="0"
			Padding="0"
			Background="{ThemeResource TileBackgroundBrush}"
			BorderBrush="{ThemeResource TileBorderBrush}"
			BorderThickness="1"
			CornerRadius="5">

			<!--  Основной контейнер с двумя макетами  -->
			<Grid>
				<!--  Горизонтальный макет (полная версия для TreeView)  -->
				<Grid x:Name="HorizontalLayout" Visibility="Visible">
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<!--  Иконка  -->
					<Image
						Grid.RowSpan="2"
						Grid.Column="0"
						Width="{x:Bind IconWidth, Mode=OneWay}"
						Height="{x:Bind IconHeight, Mode=OneWay}"
						Margin="5,0,0,0"
						VerticalAlignment="Center"
						Source="{Binding ImageSource}" />

					<!--  Основной текст  -->
					<TextBlock
						Grid.Row="0"
						Grid.Column="1"
						Margin="10,0,2,0"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						FontFamily="{x:Bind FontFamily, Mode=OneWay}"
						FontSize="{x:Bind FontSize, Mode=OneWay}"
						Foreground="{ThemeResource PrimaryTextBrush}"
						Text="{Binding Name}" />

					<!--  Прогресс-бар и информация  -->
					<StackPanel
						Grid.Row="1"
						Grid.Column="1"
						Margin="2,0"
						Orientation="Vertical">

						<ufm:CustomProgressBar
							x:Name="progressBar"
							Width="Auto"
							Margin="5,0,2,5"
							VerticalAlignment="Top"
							Maximum="100"
							Minimum="0"
							Style="{StaticResource ThickProgressBarStyle}"
							Visibility="{Binding IsProgressBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
							Value="{Binding UsedProcentValue, Mode=TwoWay}" />

						<!--  Текст использования  -->
						<Grid x:Name="GridUsedSpaceString" Margin="2,0,2,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<TextBlock
								x:Name="tbUsedSpaceSString"
								Grid.Column="0"
								Margin="2,0,0,0"
								FontSize="10"
								Foreground="{ThemeResource SecondaryTextBrush}"
								Text="{Binding UsedSpaceString}" />
							<TextBlock
								x:Name="tbFreeSpaceString"
								Grid.Column="2"
								Margin="0,0,2,0"
								FontSize="10"
								Foreground="{ThemeResource SecondaryTextBrush}"
								Text="{Binding FreeSpaceString}" />
						</Grid>
					</StackPanel>

					<!--  Блок с общим размером  -->
					<Border
						x:Name="BorderTotalSizeString"
						Grid.Row="0"
						Grid.RowSpan="2"
						Grid.Column="2"
						Width="40"
						Margin="5"
						Padding="5"
						BorderBrush="{ThemeResource SizeInfoBorderBrush}"
						BorderThickness="1"
						CornerRadius="6"
						Visibility="{Binding IsProgressBarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
						<TextBlock
							x:Name="tbTotalSizeString"
							VerticalAlignment="Center"
							FontSize="10"
							Foreground="{ThemeResource SecondaryTextBrush}"
							Text="{Binding TotalSizeString}"
							TextAlignment="Center"
							TextWrapping="Wrap" />
					</Border>
				</Grid>

				<!--  Вертикальный макет (упрощенная версия для GridView)  -->
				<Grid x:Name="VerticalLayout" Visibility="Collapsed">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<StackPanel
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Orientation="Vertical">
						<Viewbox
							Grid.Row="0"
							MaxHeight="{x:Bind MaxIconHeight, Mode=OneWay}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Stretch="Uniform">
							<!--  Иконка диска  -->
							<Image
							x:Name="DriveImage"
							Width="{x:Bind IconWidth, Mode=OneWay}"
							Height="{x:Bind IconHeight, Mode=OneWay}"
							HorizontalAlignment="Stretch"
							Source="{Binding ImageSource}"
							Stretch="Uniform" />

						</Viewbox>
						<Border
     Grid.Row="1"
     Padding="1" 
     Margin="1"
     VerticalAlignment="Stretch"
     BorderThickness="1">
							<TextBlock
								x:Name="DriveNameText"								  	
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                           TextWrapping="WrapWholeWords"
                            MaxLines="3"
                            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="{Binding Name}" />
						</Border>
					</StackPanel>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</ufm:BaseTileControl>