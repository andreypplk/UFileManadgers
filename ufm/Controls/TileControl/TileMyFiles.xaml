<?xml version="1.0" encoding="utf-8" ?>

<ufm:BaseTileControl
    x:Class="ufm.TileMyFiles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ufm="using:ufm"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ufm:DateFormatter x:Key="DateFormatter" />
    </UserControl.Resources>

    <Grid
        Width="{x:Bind Width, Mode=OneWay}"
        Height="{x:Bind Height, Mode=OneWay}"
        Background="Transparent">

        <Border
            x:Name="BorderTileFolders"
            Margin="0"
            Padding="0"
            Background="{ThemeResource TileBackgroundBrush}"
            BorderBrush="{ThemeResource TileBorderBrush}"
            BorderThickness="1"
            CornerRadius="5">

            <!--  Основной контейнер с двумя макетами  -->
            <Grid>
                <!--  Горизонтальный макет (оригинальный)  -->
                <Grid x:Name="HorizontalLayout">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="{x:Bind IconWidth, Mode=OneWay}"
                        Height="{x:Bind IconHeight, Mode=OneWay}"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Source="{Binding ImageSource}" />

                    <TextBlock
                        x:Name="FolderNameText"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,0,2,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind FontSize, Mode=OneWay}"
                        Foreground="{ThemeResource PrimaryTextBrush}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="10,0,2,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            x:Name="ItemsCountText"
                            FontSize="10"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text="{Binding ItemCountString}" />

                        <TextBlock
                            x:Name="LastModifiedText"
                            FontSize="10"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text="{Binding LastModified, Converter={StaticResource DateFormatter}}" />

                        <TextBlock
                            x:Name="AttributesText"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource SecondaryTextBrush}"
                            Text="{Binding AttributesText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!--  Вертикальный макет (добавлен новый)  -->
                <Grid x:Name="VerticalLayout" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Иконка файла  -->
                    <Viewbox
                        Grid.Row="0"
                        MaxHeight="{x:Bind MaxIconHeight, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <Image
                            x:Name="VerticalImage"
                            Source="{Binding ImageSource}"
                            Stretch="Uniform" />
                    </Viewbox>

                    <!--  Название файла  -->
                    <Border
          Grid.Row="1"
          Padding="1" 
          Margin="1"
          VerticalAlignment="Stretch"
          BorderThickness="1">
                        <TextBlock
                            x:Name="VerticalFolderNameText"                            
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            MaxLines="3"
                            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="{Binding Name}" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ufm:BaseTileControl>