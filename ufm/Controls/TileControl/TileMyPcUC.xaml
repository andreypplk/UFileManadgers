<ufm:BaseTileControl
    x:Class="ufm.TileMyPcUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ufm="using:ufm"
    mc:Ignorable="d">

    <Grid
        Width="{x:Bind Width, Mode=OneWay}"
        Height="{x:Bind Height, Mode=OneWay}"
        Background="Transparent">
        <Border
            x:Name="BorderTileMyPcUC"
            Margin="0"
            Padding="0"
            Background="{ThemeResource TileBackgroundBrush}"
            BorderBrush="{ThemeResource TileBorderBrush}"
            BorderThickness="1"
            CornerRadius="5">

            <!--  Основной контейнер, содержащий оба макета  -->
            <Grid>
                <!--  Горизонтальный макет (по умолчанию для TreeView)  -->
                <Grid x:Name="HorizontalLayout" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image
                        x:Name="HorizontalImage"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Width="{x:Bind IconWidth, Mode=OneWay}"
                        Height="{x:Bind IconHeight, Mode=OneWay}"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Source="{Binding ImageSource}" />

                    <TextBlock
                        x:Name="HorizontalText"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,0,2,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                        FontSize="{x:Bind FontSize, Mode=OneWay}"
                        Foreground="{ThemeResource PrimaryTextBrush}"
                        Text="{Binding Name}" />
                </Grid>

                <!--  Вертикальный макет (для GridView/ListView)  -->
                <Grid x:Name="VerticalLayout" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Иконка  -->
                    <Viewbox
                        Grid.Row="0"
                        MaxHeight="{x:Bind MaxIconHeight, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <Image
                            x:Name="VerticalImage"
                            Source="{Binding ImageSource}"
                            Stretch="Uniform" />
                    </Viewbox>

                    <!--  Текст  -->
                    <Border                                    
                        Grid.Row="1"
                        Padding="1" 
                        Margin="1"
                        VerticalAlignment="Stretch"
                        BorderThickness="1">
                        <TextBlock
                             x:Name="VerticalText"              
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="WrapWholeWords"
                            MaxLines="3"
                            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="{Binding Name}" />
                    </Border>
                </Grid>
            </Grid>

        </Border>
    </Grid>
</ufm:BaseTileControl>