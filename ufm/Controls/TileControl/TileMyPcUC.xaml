<ufm:BaseTileControl
    x:Class="ufm.TileMyPcUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ufm="using:ufm"
    mc:Ignorable="d">

	<Grid
        Width="{x:Bind Width, Mode=OneWay}"
        Height="{x:Bind Height, Mode=OneWay}"
        Background="Transparent">
		<Border
            x:Name="BorderTileMyPcUC"
            Margin="0"
            Padding="0"
            Background="{ThemeResource TileBackgroundBrush}"
            BorderBrush="{ThemeResource TileBorderBrush}"
            BorderThickness="1"
            CornerRadius="5">

			<!-- Основной контейнер со всеми макетами -->
			<Grid>
				<!-- Горизонтальный макет -->
				<Grid x:Name="HorizontalLayout" Visibility="Visible">
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Image
                        x:Name="HorizontalImage"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="{x:Bind IconWidth, Mode=OneWay}"
                        Height="{x:Bind IconHeight, Mode=OneWay}"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Source="{Binding ImageSource}" />

					<!-- Текст/редактирование (горизонтальный) -->
					<Grid Grid.Row="0" Grid.Column="1" Margin="10,0,2,0">
						<TextBlock
                            x:Name="HorizontalText"
                            VerticalAlignment="Center"
                            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="{Binding Name}" />
						<TextBox
                            x:Name="HorizontalEditBox"
                            VerticalAlignment="Center"
                            Style="{StaticResource EditTextBoxStyle}"
                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="Collapsed"
                            Loaded="EditTextBox_Loaded"
                            LostFocus="EditTextBox_LostFocus"
                            KeyDown="EditTextBox_KeyDown"
                            TextChanged="EditTextBox_TextChanged"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            AcceptsReturn="False"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0" />
					</Grid>
				</Grid>

				<!-- Вертикальный макет -->
				<Grid x:Name="VerticalLayout" Visibility="Collapsed">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<!-- Иконка -->
					<Viewbox
                        Grid.Row="0"
                        MaxHeight="{x:Bind MaxIconHeight, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
						<Image
                            x:Name="VerticalImage"
                            Source="{Binding ImageSource}"
                            Stretch="Uniform" />
					</Viewbox>

					<!-- Текст/редактирование (вертикальный) -->
					<Border                                    
                        Grid.Row="1"
                        Padding="1" 
                        Margin="1"
                        VerticalAlignment="Stretch"
                        BorderThickness="1">
						<Grid>
							<TextBlock
                                x:Name="VerticalText"              
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="WrapWholeWords"
                                MaxLines="3"
                                FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                                FontSize="{x:Bind FontSize, Mode=OneWay}"
                                Foreground="{ThemeResource PrimaryTextBrush}"
                                Text="{Binding Name}" />
							<TextBox
                                x:Name="VerticalEditBox"
                                VerticalAlignment="Center"
                                Style="{StaticResource EditTextBoxStyle}"
                                TextAlignment="Center"
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Collapsed"
                                Loaded="EditTextBox_Loaded"
                                LostFocus="EditTextBox_LostFocus"
                                KeyDown="EditTextBox_KeyDown"
                                TextChanged="EditTextBox_TextChanged"
                                HorizontalAlignment="Center"
                                AcceptsReturn="False"
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="0" />
						</Grid>
					</Border>
				</Grid>

				<!-- Лист макет -->
				<Grid x:Name="ListLayout" Visibility="Collapsed">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Иконка -->
					<Image
                        Grid.Column="0"
                        Width="{x:Bind IconWidth, Mode=OneWay}"
                        Height="{x:Bind IconHeight, Mode=OneWay}"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Source="{Binding ImageSource}"
                        Stretch="Uniform" />

					<!-- Текст/редактирование (лист) -->
					<Grid Grid.Column="1" Margin="10,0,5,0">
						<TextBlock
                            x:Name="ListTextBlock"
                            VerticalAlignment="Center"
                            FontFamily="{x:Bind FontFamily, Mode=OneWay}"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
						<TextBox
                            x:Name="ListEditBox"
                            VerticalAlignment="Center"
                            Style="{StaticResource EditTextBoxStyle}"
                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="Collapsed"
                            TextWrapping="NoWrap"
                            Loaded="EditTextBox_Loaded"
                            LostFocus="EditTextBox_LostFocus"
                            KeyDown="EditTextBox_KeyDown"
                            TextChanged="EditTextBox_TextChanged"
                            HorizontalAlignment="Center"
                            AcceptsReturn="False"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0" />
					</Grid>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</ufm:BaseTileControl>
	