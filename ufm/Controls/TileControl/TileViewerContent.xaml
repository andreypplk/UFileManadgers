<UserControl
    x:Class="ufm.TileViewerContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ufm="using:ufm"
    xmlns:viewModel="using:Core_FileManagement"
    x:Name="RootControl"
    mc:Ignorable="d">

	<UserControl.Resources>
		<!-- Общий базовый набор свойств -->
		<Style x:Key="CommonItemStyleBase" TargetType="Control">
			<Setter Property="Margin" Value="1" />
			<Setter Property="Padding" Value="1" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="IsDoubleTapEnabled" Value="True" />
			<Setter Property="UseSystemFocusVisuals" Value="False" />
		</Style>

		<!-- Стиль для ListViewItem -->
		<Style x:Key="ExtendedListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource CommonItemStyleBase}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListViewItem">
						<Grid x:Name="RootGrid" 
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal" />
									<VisualState x:Name="PointerOver">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="0.15" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Selected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="PointerOverSelected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="0.1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
								<VisualStateGroup x:Name="FocusStates">
									<VisualState x:Name="Focused">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisual" 
                                                                           Storyboard.TargetProperty="Visibility">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Unfocused">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisual" 
                                                                           Storyboard.TargetProperty="Visibility">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
								<VisualStateGroup x:Name="MultiSelectStates">
									<VisualState x:Name="MultiSelectEnabled" />
									<VisualState x:Name="MultiSelectDisabled" />
									<VisualState x:Name="MultiSelectEnabledSelected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>

							<Border x:Name="BaseBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />

							<Border x:Name="PointerOverVisual"
                                    Background="{ThemeResource SystemControlHighlightBaseMediumLowBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    Margin="1" />

							<Border x:Name="SelectionVisual"
                                    Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    Margin="1" />

							<Border x:Name="SelectionBorder"
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Opacity="0"
                                    Margin="2" />

							<ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />

							<Rectangle x:Name="FocusVisual"
                                       Stroke="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="1,1"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Visibility="Collapsed"
                                       Margin="-2" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Стиль для GridViewItem -->
		<Style x:Key="ExtendedGridViewItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource CommonItemStyleBase}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="GridViewItem">
						<Grid x:Name="RootGrid" 
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal" />
									<VisualState x:Name="PointerOver">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="0.15" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Selected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="PointerOverSelected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="0.1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
								<VisualStateGroup x:Name="FocusStates">
									<VisualState x:Name="Focused">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisual" 
                                                                           Storyboard.TargetProperty="Visibility">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Unfocused">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisual" 
                                                                           Storyboard.TargetProperty="Visibility">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
								<VisualStateGroup x:Name="MultiSelectStates">
									<VisualState x:Name="MultiSelectEnabled" />
									<VisualState x:Name="MultiSelectDisabled" />
									<VisualState x:Name="MultiSelectEnabledSelected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>

							<Border x:Name="BaseBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />

							<Border x:Name="PointerOverVisual"
                                    Background="{ThemeResource SystemControlHighlightBaseMediumLowBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    Margin="1" />

							<Border x:Name="SelectionVisual"
                                    Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    Margin="1" />

							<Border x:Name="SelectionBorder"
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Opacity="0"
                                    Margin="2" />

							<ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />

							<Rectangle x:Name="FocusVisual"
                                       Stroke="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="1,1"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Visibility="Collapsed"
                                       Margin="-2" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<!-- Три режима отображения, аналогично TileMyDriveUc -->

		<!-- ListView (горизонтальный макет) -->
		<ListView
            x:Name="ItemsListView"
            BorderBrush="{StaticResource AccentBorderBrush}"
            BorderThickness="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="ItemsControl_OnItemClick"
            ItemContainerStyle="{StaticResource ExtendedListViewItemStyle}"
            ItemsSource="{Binding ExplorerItems}"
            SelectionMode="Extended"
            DoubleTapped="ItemsControl_DoubleTapped"
            SelectionChanged="ItemsControl_SelectionChanged"
            KeyDown="ItemsControl_KeyDown"
            KeyUp="ItemsControl_KeyUp"
            PreviewKeyDown="ItemsControl_PreviewKeyDown"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="False"
            DragItemsStarting="ItemsControl_DragItemsStarting"
            DragOver="ItemsControl_DragOver"
            Drop="ItemsControl_Drop"
            IsSwipeEnabled="True"
            IsTapEnabled="True"
            IsHoldingEnabled="True"
            TabNavigation="Cycle"
            XYFocusKeyboardNavigation="Enabled"
            XYFocusUpNavigationStrategy="Auto"
            XYFocusDownNavigationStrategy="Auto"
            XYFocusLeftNavigationStrategy="Auto"
            XYFocusRightNavigationStrategy="Auto"
            ScrollViewer.HorizontalScrollMode="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SizeChanged="ItemsControl_SizeChanged"
            Visibility="Visible">

			<ListView.ItemTemplateSelector>
				<ufm:ListViewItemTemplateSelector>
					<ufm:ListViewItemTemplateSelector.MyComputerTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyPcUC
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.MyComputerTemplate>

					<ufm:ListViewItemTemplateSelector.DriveTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyDriveUc
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.DriveTemplate>

					<ufm:ListViewItemTemplateSelector.FolderTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyFoldersUc
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.FolderTemplate>

					<ufm:ListViewItemTemplateSelector.FileTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyFiles
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.FileTemplate>
				</ufm:ListViewItemTemplateSelector>
			</ListView.ItemTemplateSelector>

			<ListView.ItemsPanel>
				<ItemsPanelTemplate>
					<ItemsWrapGrid
                        ItemHeight="{Binding ItemHeight, ElementName=RootControl}"
                        ItemWidth="{Binding ItemWidth, ElementName=RootControl}"
                        MaximumRowsOrColumns="{Binding MaxRowsOrColumns, ElementName=RootControl}"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="2,2,2,2" />
				</ItemsPanelTemplate>
			</ListView.ItemsPanel>
		</ListView>

		<!-- GridView (вертикальный макет) -->
		<GridView
            x:Name="ItemsGridView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="ItemsControl_OnItemClick"
            ItemContainerStyle="{StaticResource ExtendedGridViewItemStyle}"
            ItemsSource="{Binding ExplorerItems}"
            SelectionMode="Extended"
            DoubleTapped="ItemsControl_DoubleTapped"
            SelectionChanged="ItemsControl_SelectionChanged"
            KeyDown="ItemsControl_KeyDown"
            KeyUp="ItemsControl_KeyUp"
            PreviewKeyDown="ItemsControl_PreviewKeyDown"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="False"
            DragItemsStarting="ItemsControl_DragItemsStarting"
            DragOver="ItemsControl_DragOver"
            Drop="ItemsControl_Drop"
            IsSwipeEnabled="True"
            IsTapEnabled="True"
            IsHoldingEnabled="True"
            TabNavigation="Cycle"
            XYFocusKeyboardNavigation="Enabled"
            XYFocusUpNavigationStrategy="Auto"
            XYFocusDownNavigationStrategy="Auto"
            XYFocusLeftNavigationStrategy="Auto"
            XYFocusRightNavigationStrategy="Auto"
            ScrollViewer.HorizontalScrollMode="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SizeChanged="ItemsControl_SizeChanged"
            Visibility="Collapsed">

			<GridView.ItemTemplateSelector>
				<ufm:ListViewItemTemplateSelector>
					<ufm:ListViewItemTemplateSelector.MyComputerTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyPcUC
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Vertical" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.MyComputerTemplate>

					<ufm:ListViewItemTemplateSelector.DriveTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyDriveUc
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Vertical" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.DriveTemplate>

					<ufm:ListViewItemTemplateSelector.FolderTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyFoldersUc
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Vertical" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.FolderTemplate>

					<ufm:ListViewItemTemplateSelector.FileTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyFiles
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Vertical" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.FileTemplate>
				</ufm:ListViewItemTemplateSelector>
			</GridView.ItemTemplateSelector>

			<GridView.ItemsPanel>
				<ItemsPanelTemplate>
					<ItemsWrapGrid
                        ItemHeight="{Binding ItemHeight, ElementName=RootControl}"
                        ItemWidth="{Binding ItemWidth, ElementName=RootControl}"
                        MaximumRowsOrColumns="24"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="2,2,2,2" />
				</ItemsPanelTemplate>
			</GridView.ItemsPanel>
		</GridView>
	</Grid>
</UserControl>