<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ufm.TileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:ufm="using:ufm"
	xmlns:viewModel="using:Core_FileManagement"
	x:Name="RootControl"
	Loaded="OnLoaded"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!-- Стиль для Extended выделения -->
		<Style x:Key="ExtendedTileListViewItemStyle" TargetType="ListViewItem">
			<Setter Property="Margin" Value="1" />
			<Setter Property="Padding" Value="1" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="IsDoubleTapEnabled" Value="True" />
			<Setter Property="UseSystemFocusVisuals" Value="False" />

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListViewItem">
						<Grid x:Name="RootGrid" 
                              Background="Transparent"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">

							<VisualStateManager.VisualStateGroups>
								<!-- Common States -->
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal" />

									<VisualState x:Name="PointerOver">
										<Storyboard>
											<!-- Наведение на любой элемент -->
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="0.15" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>

									<VisualState x:Name="Selected">
										<Storyboard>
											<!-- Выделение одиночного элемента -->
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>

									<VisualState x:Name="PointerOverSelected">
										<Storyboard>
											<!-- Наведение на выделенный элемент -->
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="PointerOverVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="0.1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>

								<!-- Focus States -->
								<VisualStateGroup x:Name="FocusStates">
									<VisualState x:Name="Focused">
										<Storyboard>
											<!-- Клавиатурный фокус (может быть на выделенном или не выделенном) -->
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisual" 
                                                                           Storyboard.TargetProperty="Visibility">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Unfocused">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusVisual" 
                                                                           Storyboard.TargetProperty="Visibility">
												<DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>

								<!-- MultiSelect States для Extended режима -->
								<VisualStateGroup x:Name="MultiSelectStates">
									<VisualState x:Name="MultiSelectEnabled" />
									<VisualState x:Name="MultiSelectDisabled" />
									<!-- Это состояние когда элемент выделен в режиме множественного выбора -->
									<VisualState x:Name="MultiSelectEnabledSelected">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionVisual" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBorder" 
                                                                           Storyboard.TargetProperty="Opacity">
												<DiscreteObjectKeyFrame KeyTime="0" Value="1" />
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>

							<!-- Основной бордер -->
							<Border x:Name="BaseBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />

							<!-- Визуализация наведения -->
							<Border x:Name="PointerOverVisual"
                                    Background="{ThemeResource SystemControlHighlightBaseMediumLowBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    Margin="1" />

							<!-- Фон выделения (для ВСЕХ выделенных элементов) -->
							<Border x:Name="SelectionVisual"
                                    Background="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    Margin="1" />

							<!-- Граница выделения (для ВСЕХ выделенных элементов) -->
							<Border x:Name="SelectionBorder"
                                    BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Opacity="0"
                                    Margin="2" />

							<!-- Контент -->
							<ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />

							<!-- Фокусная рамка (только для элемента с клавиатурным фокусом) -->
							<Rectangle x:Name="FocusVisual"
                                       Stroke="{ThemeResource SystemControlFocusVisualPrimaryBrush}"
                                       StrokeThickness="2"
                                       StrokeDashArray="1,1"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Visibility="Collapsed"
                                       Margin="-2" />
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<ListView
            x:Name="ItemsListView"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsItemClickEnabled="True"
            ItemClick="ItemsListView_OnItemClick"
            ItemContainerStyle="{StaticResource ExtendedTileListViewItemStyle}"
            ItemsSource="{Binding ExplorerItems}"
            SelectionMode="Extended"
            DoubleTapped="ItemsListView_DoubleTapped"
            SelectionChanged="ItemsListView_SelectionChanged"
            KeyDown="ItemsListView_KeyDown"
            KeyUp="ItemsListView_KeyUp"
            PreviewKeyDown="ItemsListView_PreviewKeyDown"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="False"
            IsSwipeEnabled="True"
            IsTapEnabled="True"
            IsHoldingEnabled="True"
            TabNavigation="Cycle"
            XYFocusKeyboardNavigation="Enabled"
            XYFocusUpNavigationStrategy="Auto"
            XYFocusDownNavigationStrategy="Auto"
            XYFocusLeftNavigationStrategy="Auto"
            XYFocusRightNavigationStrategy="Auto">
			<!-- 
			KeyDown - обработка нажатия клавиш
			KeyUp - обработка отпускания клавиш  
			PreviewKeyDown - предварительная обработка клавиш
			AllowDrop - разрешить перетаскивание
			CanDragItems - разрешить drag & drop элементов
			IsSwipeEnabled - разрешить жесты свайпа
			TabNavigation="Cycle" - циклическая навигация Tab
			XYFocusKeyboardNavigation - навигация стрелками в 2D пространстве
			-->

			<ListView.ItemTemplateSelector>
				<ufm:ListViewItemTemplateSelector>
					<ufm:ListViewItemTemplateSelector.MyComputerTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyPcUC
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.MyComputerTemplate>

					<ufm:ListViewItemTemplateSelector.DriveTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyDriveUc
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.DriveTemplate>

					<ufm:ListViewItemTemplateSelector.FolderTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyFoldersUc
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.FolderTemplate>

					<ufm:ListViewItemTemplateSelector.FileTemplate>
						<DataTemplate x:DataType="viewModel:ExplorerItemViewModel">
							<ufm:TileMyFiles
                                Width="{Binding ItemWidth, ElementName=RootControl}"
                                Height="{Binding ItemHeight, ElementName=RootControl}"
                                DisplayMode="Horizontal" />
						</DataTemplate>
					</ufm:ListViewItemTemplateSelector.FileTemplate>
				</ufm:ListViewItemTemplateSelector>
			</ListView.ItemTemplateSelector>

			<ListView.ItemsPanel>
				<ItemsPanelTemplate>
					<ItemsWrapGrid
                        ItemHeight="{Binding ItemHeight, ElementName=RootControl}"
                        ItemWidth="{Binding ItemWidth, ElementName=RootControl}"
                        MaximumRowsOrColumns="24"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="2,2,2,2" />
				</ItemsPanelTemplate>
			</ListView.ItemsPanel>

			<!-- 
			Необязательные дополнительные возможности ListView:
			<GridView.GroupStyle>
				<GroupStyle>
					<GroupStyle.HeaderTemplate>
						<DataTemplate>
							...
						</DataTemplate>
					</GroupStyle.HeaderTemplate>
				</GroupStyle>
			</GridView.GroupStyle>
			
			<GridView.Header>
				<Grid Height="40">
					<TextBlock Text="Файлы и папки" FontSize="16" VerticalAlignment="Center"/>
				</Grid>
			</GridView.Header>
			
			<GridView.Footer>
				<Grid Height="40">
					<TextBlock Text="{Binding Items.Count, StringFormat='Всего элементов: {0}'}" 
                              VerticalAlignment="Center" HorizontalAlignment="Right"/>
				</Grid>
			</GridView.Footer>
			-->
		</ListView>

		<!-- 
		Необязательно: Контекстное меню для ListView
		<FlyoutBase.AttachedFlyout>
			<MenuFlyout>
				<MenuFlyoutItem Text="Копировать" Click="CopyMenuItem_Click"/>
				<MenuFlyoutItem Text="Вырезать" Click="CutMenuItem_Click"/>
				<MenuFlyoutItem Text="Вставить" Click="PasteMenuItem_Click"/>
				<MenuFlyoutSeparator/>
				<MenuFlyoutItem Text="Удалить" Click="DeleteMenuItem_Click"/>
				<MenuFlyoutItem Text="Переименовать" Click="RenameMenuItem_Click"/>
				<MenuFlyoutSeparator/>
				<MenuFlyoutItem Text="Свойства" Click="PropertiesMenuItem_Click"/>
			</MenuFlyout>
		</FlyoutBase.AttachedFlyout>
		-->
	</Grid>
</UserControl>