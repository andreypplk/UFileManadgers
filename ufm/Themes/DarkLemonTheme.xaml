<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ufm"
    xmlns:ui="using:Windows.UI">
    <!--  Основные цвета  -->
   <ui:Color x:Key="SystemAccentColor">#B8860B</ui:Color>
<ui:Color x:Key="AppBackgroundColor">#1A1A00</ui:Color>
<ui:Color x:Key="CardBackgroundColor">#2B2B0A</ui:Color>
<ui:Color x:Key="PanelHoverColor">#30B8860B</ui:Color>
<!-- Текст -->
<ui:Color x:Key="TextPrimaryColor">#FFFACD</ui:Color>
<ui:Color x:Key="TextSecondaryColor">#B3AD8F</ui:Color>
<ui:Color x:Key="TextOnAccentColor">#000000</ui:Color>

<!-- Кнопки -->
<ui:Color x:Key="ButtonBackgroundColor">#3D3D1A</ui:Color>
<ui:Color x:Key="ButtonBorderColor">#B8860B</ui:Color>
<ui:Color x:Key="ButtonHoverColor">#4A4A1F</ui:Color>
<ui:Color x:Key="ButtonPressedColor">#DAA520</ui:Color>
<ui:Color x:Key="ButtonDisabledColor">#2A2A15</ui:Color>

<!-- Границы -->
<ui:Color x:Key="BorderPrimaryColor">#3D3D1A</ui:Color>
<ui:Color x:Key="BorderSecondaryColor">#5D5D2A</ui:Color>

<!-- Прогресс-бар -->
<ui:Color x:Key="ProgressBarTrackColor">#3D3D1A</ui:Color>
<ui:Color x:Key="ProgressBarThumbColor">#B8860B</ui:Color>
<ui:Color x:Key="CriticalProgressColor">#FF6B6B</ui:Color>

<!-- Плитки -->
<ui:Color x:Key="TileBackgroundColor">#2B2B0A</ui:Color>
<ui:Color x:Key="TileBorderColor">#B8860B</ui:Color>
<ui:Color x:Key="SizeInfoBorderColor">#3D3D1A</ui:Color>

<!-- Дополнительные цвета -->
<ui:Color x:Key="HeaderBackgroundColor">#3D3D1A</ui:Color>
<ui:Color x:Key="HeaderBorderColor">#B8860B</ui:Color>
<ui:Color x:Key="NavigationButtonColor">#3D3D1A</ui:Color>
<ui:Color x:Key="NavigationIconColor">#FFD700</ui:Color>
</ResourceDictionary>
