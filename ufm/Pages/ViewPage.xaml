                                            GroupName="ViewModeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Icons" />
										<RadioButton
                                            x:Name="ListModeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMVList"
