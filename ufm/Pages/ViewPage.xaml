                            x:Name="CustomBreadcrumb"
                            ItemClicked="CustomBreadcrumb_ItemClicked" />
					</Border>
					<!--  Поиск  -->

					<AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        Width="220"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardBackgroundBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
