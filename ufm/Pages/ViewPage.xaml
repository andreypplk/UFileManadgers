<!--<Page
    x:Class="ufm.ViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Lngmng="using:Core_Language"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModel="using:Core_FileManagement"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.DataContext>
        <viewModel:MainViewModel />
    </Page.DataContext>

    <Page.Resources>

        <Style x:Key="SmallRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid
                            x:Name="RootGrid"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                x:Name="OuterEllipseGrid"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <Ellipse
                                    x:Name="OuterEllipse"
                                    Width="12"
                                    Height="12"
                                    Fill="{ThemeResource ButtonBackgroundColor}"
                                    Stroke="{ThemeResource ButtonBorderColor}"
                                    StrokeThickness="1" />
                                <Ellipse
                                    x:Name="CheckGlyph"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource SystemAccentColor}"
                                    Opacity="0" />
                            </Grid>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{ThemeResource TextPrimaryColor}"
                                TextWrapping="Wrap" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemAccentColor}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemAccentColorDark1}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OuterEllipse" Storyboard.TargetProperty="Stroke">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextSecondaryColor}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextSecondaryColor}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="CheckGlyph"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="OperationButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="PanelContentControlStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentBorderBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource AccentBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        --><!--  Добавляем стиль для панели предпросмотра  --><!--
        <Style x:Key="PreviewPanelStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Page.Resources>

    <Grid x:Name="GridViewDataPage">
        <Grid x:Name="GridWorkAreaView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            --><!--  Верхнее меню навигации  --><!--

            <Border
                x:Name="GridMenuFirst"
                Grid.Row="0"
                Padding="10,5"
                Background="{StaticResource NavigationButtonBrush}"
                CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    --><!--  Кнопки навигации  --><!--

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="BackButton"
                            Lngmng:Uids.ToolTipUid="VPfirstmemustBut_ttsttBtBackButton"
                            Click="BackButton_Click"
                            Content="&#xE72B;"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="{StaticResource NavigationIconBrush}" />
                        <Button
                            x:Name="ForwardButton"
                            Lngmng:Uids.ToolTipUid="VPfirstmemustBut_ttsttBtForwardButton"
                            Click="ForwardButton_Click"
                            Content="&#xE72A;"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="{StaticResource NavigationIconBrush}" />
                        <Button
                            x:Name="UpButton"
                            Lngmng:Uids.ToolTipUid="VPfirstmemustBut_ttsttBtUpButton"
                            Click="UpButton_Click"
                            Content="&#xE74A;"
                            FontFamily="Segoe fluent icons"
                            Foreground="{StaticResource NavigationIconBrush}" />
                        <Button
                            x:Name="RefreshButton"
                            Lngmng:Uids.ToolTipUid="VPfirstmemustBut_ttsttBtRefreshButton"
                            Click="RefreshButton_Click"
                            Content="&#xE72C;"
                            FontFamily="Segoe fluent icons"
                            Foreground="{StaticResource NavigationIconBrush}" />
                    </StackPanel>
                    --><!--  Хлебные крошки  --><!--

                    <Border
                        Grid.Column="1"
                        Margin="10,0"
                        Padding="5"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <BreadcrumbBar x:Name="BreadcrumbBar" ItemClicked="BreadcrumbBar_ItemClicked">
                            <BreadcrumbBar.Resources>
                                <Style TargetType="BreadcrumbBarItem">
                                    <Setter Property="Margin" Value="2,0" />
                                    <Setter Property="Padding" Value="6,2" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                </Style>
                            </BreadcrumbBar.Resources>
                        </BreadcrumbBar>
                    </Border>
                    --><!--  Поиск  --><!--

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="2"
                        Width="220"
                        VerticalAlignment="Center"
                        Background="{StaticResource CardBackgroundBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        PlaceholderText="..."
                        QueryIcon="Find"
                        QuerySubmitted="SearchBox_QuerySubmitted" />
                </Grid>
            </Border>
            --><!--  Панель инструментов  --><!--

            <Border
                x:Name="GridMenuSecond"
                Grid.Row="1"
                Padding="10,5"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}"
                BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    --><!--  Кнопки операций  --><!--

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="CopyButton"
                            Lngmng:Uids.ToolTipUid="VPsecondmemustBut_ttsttBtCopyButton"
                            Click="CopyButton_Click"
                            Content="&#xE8C8;"
                            Style="{StaticResource OperationButtonStyle}" />
                        <Button
                            x:Name="MoveButton"
                            Lngmng:Uids.ToolTipUid="VPsecondmemustBut_ttsttBtMoveButton"
                            Click="MoveButton_Click"
                            Content="&#xE715;"
                            Style="{StaticResource OperationButtonStyle}" />

                        <Button
                            x:Name="RenameButton"
                            Lngmng:Uids.ToolTipUid="VPsecondmemustBut_ttsttBtRenameButton"
                            Click="RenameButton_Click"
                            Content="&#xE8AC;"
                            Style="{StaticResource OperationButtonStyle}" />

                        <Button
                            x:Name="CutButton"
                            Lngmng:Uids.ToolTipUid="VPsecondmemustBut_ttsttBtCutButton"
                            Click="CutButton_Click"
                            Content="&#xE8C6;"
                            Style="{StaticResource OperationButtonStyle}" />

                        <Button
                            x:Name="PasteButton"
                            Lngmng:Uids.ToolTipUid="VPsecondmemustBut_ttsttBtPasteButton"
                            Click="PasteButton_Click"
                            Content="&#xE77F;"
                            Style="{StaticResource OperationButtonStyle}" />

                        <Button
                            x:Name="DeleteButton"
                            Lngmng:Uids.ToolTipUid="VPsecondmemustBut_ttsttBtDeleteButton"
                            Click="DeleteButton_Click"
                            Content="&#xE74D;"
                            Style="{StaticResource OperationButtonStyle}" />

                    </StackPanel>
                    --><!--  Пустое пространство между кнопками операций и выпадающими меню  --><!--

                    <Grid Grid.Column="1" />
                    --><!--  Выпадающие меню (выровнены по правому краю) ЛОКАЛИЗОВАТЬ  --><!--

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10">

                        <muxc:DropDownButton
                            x:Name="ViewModeButton"
                            Lngmng:Uids.ToolTipUid="VPfirstrmFI_ttsttViewchangesMode"
                            Background="{StaticResource NavigationButtonBrush}"
                            Foreground="{StaticResource NavigationIconBrush}">

                            <FontIcon Glyph="&#xE152;" />

                            <muxc:DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    --><!--  Субменю для одной панели  --><!--

                                    <MenuFlyoutSubItem Lngmng:Uids.Uid="VPfirstrmFI_SinglePanel">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xF56E;" />
                                        </MenuFlyoutSubItem.Icon>
                                        <RadioMenuFlyoutItem
                                            x:Name="SingleViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_SinglePanel"
                                            Click="SingleView_Click"
                                            GroupName="PanelLayoutGroup"
                                            IsChecked="True">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF56E;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                    </MenuFlyoutSubItem>
                                    --><!--  Субменю для двух панелей  --><!--

                                    <MenuFlyoutSubItem Lngmng:Uids.Uid="VPfirstrmFI_TwoPanels">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xF57C;" />
                                        </MenuFlyoutSubItem.Icon>
                                        <RadioMenuFlyoutItem
                                            x:Name="VerticalViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_VerticalTwoPanels"
                                            Click="VerticalView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF464;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="HorizontalViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_HorizontalTwoPanels"
                                            Click="HorizontalView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF462;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                    </MenuFlyoutSubItem>
                                    --><!--  Субменю для трех панелей  --><!--

                                    <MenuFlyoutSubItem Lngmng:Uids.Uid="VPfirstrmFI_ThreePanels">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xECAA;" />
                                        </MenuFlyoutSubItem.Icon>
                                        <RadioMenuFlyoutItem
                                            x:Name="TripleVerticalViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_VerticalThreePanels"
                                            Click="TripleVerticalView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C0;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="TripleHorizontalViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_HorizontalThreePanels"
                                            Click="TripleHorizontalView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE700;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="TripleTopBottomViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_TripleTopBottomThreePanels"
                                            Click="TripleTopBottomView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE96E;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="TripleBottomTopViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_TripleBottomTopThreePanels"
                                            Click="TripleBottomTopView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE96D;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="TripleLeftRightViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_TripleLeftRightThreePanels"
                                            Click="TripleLeftRightView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE96F;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="TripleRightLeftViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_TripleRightLeftThreePanels"
                                            Click="TripleRightLeftView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE970;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                    </MenuFlyoutSubItem>
                                    --><!--  Субменю для четырех панелей  --><!--

                                    <MenuFlyoutSubItem Lngmng:Uids.Uid="VPfirstrmFI_QuadPanels">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xE8A9;" />
                                        </MenuFlyoutSubItem.Icon>
                                        <RadioMenuFlyoutItem
                                            x:Name="QuadViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_QuadQuadPanels"
                                            Click="QuadView_Click"
                                            GroupName="PanelLayoutGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A9;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Lngmng:Uids.Uid="VPfirstrmFI_PreviewPanels">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xE8FF;" />
                                        </MenuFlyoutSubItem.Icon>
                                        <RadioMenuFlyoutItem
                                            x:Name="PreviewLeftRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_PreviewLeftPanels"
                                            Click="PreviewLeft_Click"
                                            GroupName="PreviewPanelGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE26B;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="PreviewRightRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_PreviewRightPanels"
                                            Click="PreviewRight_Click"
                                            GroupName="PreviewPanelGroup">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE26C;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                        <RadioMenuFlyoutItem
                                            x:Name="PreviewNoneRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_PreviewHidePanels"
                                            Click="PreviewNone_Click"
                                            GroupName="PreviewPanelGroup"
                                            IsChecked="True">
                                            <RadioMenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" />
                                            </RadioMenuFlyoutItem.Icon>
                                        </RadioMenuFlyoutItem>
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </muxc:DropDownButton.Flyout>
                        </muxc:DropDownButton>


                        <muxc:DropDownButton
                            x:Name="ViewModeDropDownButton"
                            Margin="10,0"
                            Lngmng:Uids.ToolTipUid="VPsecondrmFI_ttsttViewMode"
                            Background="{ThemeResource NavigationButtonBrush}"
                            Foreground="{ThemeResource NavigationIconBrush}"
                            RelativePanel.AlignRightWithPanel="True"
                            RelativePanel.AlignVerticalCenterWithPanel="True">

                            <FontIcon Glyph="&#xE762;" />

                            <muxc:DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Background="{ThemeResource CardBackgroundBrush}">
                                        --><!--  Секция размеров значков  --><!--

                                        <TextBlock
                                            Margin="12,8,12,4"
                                            Lngmng:Uids.Uid="VPsecondrmFI_txtddtSizeIcon"
                                            Foreground="{ThemeResource TextSecondaryColor}"
                                            Style="{ThemeResource CaptionTextBlockStyle}" />

                                        <RadioButton
                                            x:Name="TinySizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbTinySizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Tiny" />

                                        <RadioButton
                                            x:Name="ExtraSmallSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbExtraSmallSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Extra Small" />

                                        <RadioButton
                                            x:Name="SmallSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbSmallSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Small" />

                                        <RadioButton
                                            x:Name="BelowMediumSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbBelowMediumSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Below Medium" />

                                        <RadioButton
                                            x:Name="MediumSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMediumSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Medium" />

                                        <RadioButton
                                            x:Name="AboveMediumSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbAboveMediumSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Above Medium" />

                                        <RadioButton
                                            x:Name="LargeSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbLargeSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Large" />

                                        <RadioButton
                                            x:Name="ExtraLargeSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbExtraLargeSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Extra Large" />

                                        <RadioButton
                                            x:Name="HugeSizeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbHugeSizeIcon"
                                            Checked="SizeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="SizeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Huge" />

                                        <muxc:MenuFlyoutSeparator />
                                        --><!--  Секция режимов отображения  --><!--

                                        <TextBlock
                                            Margin="12,8,12,4"
                                            Lngmng:Uids.Uid="VPsecondrmFI_txtddtModeViewing"
                                            Foreground="{ThemeResource TextSecondaryColor}"
                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                        <RadioButton
                                            x:Name="IconsModeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMVIcons"
                                            Checked="ViewModeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="ViewModeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Icons" />
                                        <RadioButton
                                            x:Name="ListModeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMVList"
                                            Checked="ViewModeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="ViewModeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="List" />

                                        <RadioButton
                                            x:Name="CompListModeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMVCompList"
                                            Checked="ViewModeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="ViewModeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="CompactList" />

                                        <RadioButton
                                            x:Name="TilesModeRadioButton"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMVTiles"
                                            Checked="ViewModeRadioButton_Checked"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="ViewModeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Tiles" />

                                        <RadioButton
                                            x:Name="TableModeRadioButton"
                                            Checked="ViewModeRadioButton_Checked"
                                            Lngmng:Uids.RadioButtonContentUid="VPsecondrmFI_ddbrbMVTable"
                                            Foreground="{ThemeResource TextPrimaryColor}"
                                            GroupName="ViewModeGroup"
                                            Style="{StaticResource SmallRadioButtonStyle}"
                                            Tag="Table" />
                                    </StackPanel>
                                </Flyout>
                            </muxc:DropDownButton.Flyout>
                        </muxc:DropDownButton>
                    </StackPanel>
                </Grid>
            </Border>
            --><!--  Основная рабочая область  --><!--

            <Grid Grid.Row="2" Background="{StaticResource AppBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        x:Name="ColumPreviewLeft"
                        Width="Auto"
                        MinWidth="0"
                        MaxWidth="800" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition
                        Width="*"
                        MinWidth="100"
                        MaxWidth="4096" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition
                        x:Name="ColumPreviewRigth"
                        Width="Auto"
                        MinWidth="0"
                        MaxWidth="800" />
                </Grid.ColumnDefinitions>


                --><!--  Левая панель предпросмотра  --><!--
                <Grid
                    x:Name="PreviewPanelLeft"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                    BorderThickness="5"
                    Visibility="Collapsed">
                    <ContentControl x:Name="PreviewContentLeft" Style="{StaticResource PreviewPanelStyle}" />
                </Grid>

                --><!--  Разделитель левой панели  --><!--
                <controls1:GridSplitter
                    x:Name="LeftPreviewSplitter"
