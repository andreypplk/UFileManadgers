                            Height="1"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ResizeBehavior="PreviousAndNext"
                            ResizeDirection="Rows">
							<controls1:GridSplitter.RenderTransform>
								<TranslateTransform Y="-7" />
