                    Background="Transparent"
                    PointerReleased="PreviewSplitter_PointerReleased"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    Visibility="Collapsed">
                    <controls1:GridSplitter.RenderTransform>
                        <TranslateTransform X="-7" />
                    </controls1:GridSplitter.RenderTransform>
                </controls1:GridSplitter>

                --><!--  Основная рабочая область с разделителями для панели предпросмотра  --><!--


                <Grid x:Name="FilePanelsContainer" Grid.Column="2">
                    <Grid
                        x:Name="SingleViewGrid"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
