                                            Lngmng:Uids.Uid="VPfirstrmFI_TripleBottomTopThreePanels"
                                            Click="TripleBottomTopView_Click"
                                            GroupName="PanelLayoutGroup">
											<RadioMenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE96D;" />
											</RadioMenuFlyoutItem.Icon>
										</RadioMenuFlyoutItem>
										<RadioMenuFlyoutItem
                                            x:Name="TripleLeftRightViewRadio"
                                            Lngmng:Uids.Uid="VPfirstrmFI_TripleLeftRightThreePanels"
                                            Click="TripleLeftRightView_Click"
                                            GroupName="PanelLayoutGroup">
											<RadioMenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE96F;" />
											</RadioMenuFlyoutItem.Icon>
										</RadioMenuFlyoutItem>
										<RadioMenuFlyoutItem
                                            x:Name="TripleRightLeftViewRadio"
