                                            GroupName="PanelLayoutGroup">
											<RadioMenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE970;" />
											</RadioMenuFlyoutItem.Icon>
										</RadioMenuFlyoutItem>
									</MenuFlyoutSubItem>
									<!--  Субменю для четырех панелей  -->

									<MenuFlyoutSubItem Lngmng:Uids.Uid="VPfirstrmFI_QuadPanels">
