                    --><!--  Тройное представление - вариант 2 (горизонтальное)  --><!--
                    <Grid
                        x:Name="TripleHorizontalViewGrid"
                        x:FieldModifier="public"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="100" />
