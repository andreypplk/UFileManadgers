                                            GroupName="PreviewPanelGroup">
											<RadioMenuFlyoutItem.Icon>
												<FontIcon Glyph="&#xE26B;" />
											</RadioMenuFlyoutItem.Icon>
										</RadioMenuFlyoutItem>
										<RadioMenuFlyoutItem
                                            x:Name="PreviewRightRadio"
