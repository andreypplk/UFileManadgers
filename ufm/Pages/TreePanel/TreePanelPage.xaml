<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ufm.TreePanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ufm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AppBackgroundBrush}"
    mc:Ignorable="d">

    <Grid
        x:Name="GridTreeView"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent"
        Visibility="Visible">

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="*"
                MinWidth="150"
                MaxWidth="800" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition
                Height="*"
                MinHeight="40"
                MaxHeight="4320" />
        </Grid.RowDefinitions>

        <Border
            Grid.Column="0"
            MinWidth="50"
            MaxWidth="800"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="Transparent"
            BorderBrush="{ThemeResource BorderPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6">

            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="5" />
                    <RowDefinition
                        Height="200"
                        MinHeight="80"
                        MaxHeight="800" />
                </Grid.RowDefinitions>

                <!--  Кнопки (оставил старую сетку, но применил новые стили)  -->

                <Grid Grid.Row="0" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{ThemeResource ButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource ButtonBorderBrush}"
                        BorderThickness="1"
                        Click="ButtonTreePage1_OnClick"
                        Content="My PC"
                        CornerRadius="6"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ButtonTextBrush}" />

                    <Button
                        Grid.Column="1"
                        Margin="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{ThemeResource ButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource ButtonBorderBrush}"
                        BorderThickness="1"
                        Click="ButtonTreePage2_OnClick"
                        Content="Network"
                        CornerRadius="6"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ButtonTextBrush}" />

                    <Button
                        Grid.Column="2"
                        Margin="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{ThemeResource ButtonBackgroundBrush}"
                        BorderBrush="{ThemeResource ButtonBorderBrush}"
                        BorderThickness="1"
                        Click="ButtonTreePage3_OnClick"
                        Content="Favorites"
                        CornerRadius="6"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ButtonTextBrush}" />
                </Grid>

                <!--  Контейнер для TreeView (оставил без изменений)  -->

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Frame
                        x:Name="FrameWithinGrid"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition>
                                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                        <SlideNavigationTransitionInfo Effect="FromRight" />
                                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                </NavigationThemeTransition>
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>
                </Grid>

                <!--  GridSplitter (оставил оригинальный стиль)  -->

                <controls:GridSplitter
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Height="16"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Rows">
                    <controls:GridSplitter.RenderTransform>
                        <TranslateTransform Y="-7" />
                    </controls:GridSplitter.RenderTransform>
                </controls:GridSplitter>

                <!--  Нижняя панель (использовал CardBackgroundBrush)  -->

                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    MinWidth="50"
                    MaxWidth="800"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
