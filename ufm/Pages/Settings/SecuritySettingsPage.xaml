<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ufm.Pages.Settings.SecuritySettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ufm.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Security Settings" />

            <!--  Пароль на настройки  -->
            <PasswordBox Header="Set Password" />

            <!--  Автоблокировка  -->
            <NumberBox Header="Auto-lock after (minutes)" />
        </StackPanel>
    </ScrollViewer>
</Page>
