<Window
    x:Class="ufm.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:LngMng="using:Core_Language"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ufm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<NavigationView
            x:Name="nvSample"
            HorizontalAlignment="Stretch"
            AlwaysShowHeader="True"
            CompactPaneLength="50"
            ExpandedModeThresholdWidth="500"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTabStop="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            PaneTitle="Settings"
            SelectionChanged="NvSample_OnSelectionChanged"
            SelectionFollowsFocus="Disabled">

			<NavigationView.MenuItems>
				<NavigationViewItem x:Name="GeneralSettingsItem" Content="General" Tag="GeneralSettingsPage">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE713;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem x:Name="AdvancedSettingsItem" Content="Advanced" Tag="AdvancedSettingsPage">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE713;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem x:Name="SecuritySettingsItem" Content="Security" Tag="SecuritySettingsPage">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE72E;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem x:Name="PluginsSettingsItem" Content="Plugins" Tag="PluginsSettingsPage">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE8F1;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
			</NavigationView.MenuItems>

			<Frame x:Name="contentFrame" Margin="16" />
		</NavigationView>

		<!-- Компактная панель: три кнопки в ряд, под ними переключатель -->
		<StackPanel
            Grid.Row="0"
            Margin="20,10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Spacing="8">

			<!-- Ряд кнопок -->
			<StackPanel Orientation="Horizontal" Spacing="8">
				<!-- Reset -->
				<Button
                    Width="36" Height="36"
                    Padding="4"
                    Click="ResetSettingsButton_Click"
                    ToolTipService.ToolTip="Reset Settings">
					<FontIcon Glyph="&#xE777;" FontSize="16" />
				</Button>

				<!-- Export -->
				<Button
                    Width="36" Height="36"
                    Padding="4"
                    Click="ExportSettingsButton_Click"
                    ToolTipService.ToolTip="Export Settings">
					<FontIcon Glyph="&#xEDE1;" FontSize="16" />
				</Button>

				<!-- Import -->
				<Button
                    Width="36" Height="36"
                    Padding="4"
                    Click="ImportSettingsButton_Click"
                    ToolTipService.ToolTip="Import Settings">
					<FontIcon Glyph="&#xE8B5;" FontSize="16" />
				</Button>
			</StackPanel>

			<!-- Переключатель портативного режима -->
			<StackPanel Orientation="Horizontal"
            ToolTipService.ToolTip="Toggle portable mode (store settings next to EXE)"
            Margin="18,0,0,0">
				<FontIcon Glyph="&#xEC4E;" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" />
				<ToggleSwitch
                    x:Name="PortableModeToggle"
                    Toggled="PortableModeToggle_Toggled"
                    Header=""
                    MinWidth="0" />
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>